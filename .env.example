# Banco PostgreSQL do VR
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=reidaeconomia
PGUSER=postgres
# Senha armazenada em Base64 pelo instalador (nao e criptografia; o arquivo recebe ACL restrita)
PGPASSWORD_B64=

# ID numerico desta unidade na tabela public.loja do VR
VR_LOJA_ID=

# Identificador unico da unidade no Encarte Inteligente (ex.: loja-01)
ENCARTE_LOJA=

# API central do Encarte Inteligente (HTTPS)
ENCARTE_API_URL=https://encarte-inteligente.vercel.app
ENCARTE_API_TOKEN_B64=
